# serializer version: 1
# name: test_the_event_sequence_matches_the_snapshot[breaker_opening]
  list([
    dict({
      'call': dict({
        'full_url': 'https://api.example.test/v1/x',
        'method': 'GET',
        'route': None,
        'url': 'x',
      }),
      'event': 'CallStarted',
    }),
    dict({
      'attempt': 1,
      'call': dict({
        'full_url': 'https://api.example.test/v1/x',
        'method': 'GET',
        'route': None,
        'url': 'x',
      }),
      'error': None,
      'event': 'AttemptFinished',
      'status_code': 503,
    }),
    dict({
      'call': dict({
        'full_url': 'https://api.example.test/v1/x',
        'method': 'GET',
        'route': None,
        'url': 'x',
      }),
      'event': 'BreakerChanged',
      'failures': 1,
      'origin': 'https://api.example.test',
      'previous': <BreakerState.CLOSED: 'closed'>,
      'state': <BreakerState.OPEN: 'open'>,
    }),
    dict({
      'attempts': 1,
      'call': dict({
        'full_url': 'https://api.example.test/v1/x',
        'method': 'GET',
        'route': None,
        'url': 'x',
      }),
      'error': 'UpstreamStatusError',
      'event': 'CallFinished',
      'status_code': None,
    }),
    dict({
      'call': dict({
        'full_url': 'https://api.example.test/v1/x',
        'method': 'GET',
        'route': None,
        'url': 'x',
      }),
      'event': 'CallStarted',
    }),
    dict({
      'attempts': 0,
      'call': dict({
        'full_url': 'https://api.example.test/v1/x',
        'method': 'GET',
        'route': None,
        'url': 'x',
      }),
      'error': 'CircuitOpenError',
      'event': 'CallFinished',
      'status_code': None,
    }),
  ])
